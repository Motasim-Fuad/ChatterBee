# Copy to .env and fill from the CodeMagic "chatterbee" variable group.
# .env is gitignored. Do not commit real values.

# Compiled into the app via --dart-define (RevenueCat public SDK keys only).
RC_ANDROID_PUBLIC_KEY=
RC_IOS_PUBLIC_KEY=

# Android release signing. Script writes android/key.properties from these.
# Put the keystore at android/keystore.jks
# If you only have the CodeMagic base64 blob, paste it in CM_KEYSTORE and the script will decode it.
CM_KEYSTORE_PASSWORD=
CM_KEY_PASSWORD=
CM_KEY_ALIAS=
CM_KEYSTORE=

# Optional. Only needed if you upload from this machine (Play / TestFlight).
# The Flutter app does not read these.
GCLOUD_SERVICE_ACCOUNT_CREDENTIALS=
APP_STORE_CONNECT_KEY_IDENTIFIER=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=
CERTIFICATE_PRIVATE_KEY=
